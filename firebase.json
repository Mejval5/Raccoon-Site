{
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/blog",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/blogpost/CaminoPortugese",
        "destination": "/camino/",
        "type": 301
      },
      {
        "source": "/blogpost/TowerDefenseCourse",
        "destination": "/games/",
        "type": 301
      },
      {
        "source": "/blogpost/Octomancer:rest*",
        "destination": "/octomancer/",
        "type": 301
      },
      {
        "source": "/blogpost/**",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/preverenges/en",
        "destination": "/preverenges/",
        "type": 301
      },
      {
        "source": "/preverenges/fr",
        "destination": "/preverenges/?lang=fr",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/svatba/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/shadinglanguagex/lib/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/gallery",
        "function": {
          "functionId": "gallery",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/gallery/**",
        "function": {
          "functionId": "gallery",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/rsvp",
        "function": {
          "functionId": "rsvp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/dary",
        "function": {
          "functionId": "dary",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/dary/**",
        "function": {
          "functionId": "dary",
          "region": "europe-west1"
        }
      },
      {
        "source": "/chess",
        "run": {
          "serviceId": "chess",
          "region": "europe-west1"
        }
      },
      {
        "source": "/chess/**",
        "run": {
          "serviceId": "chess",
          "region": "europe-west1"
        }
      }
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/deploy-guard.js\""
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/deploy-guard.js\""
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
